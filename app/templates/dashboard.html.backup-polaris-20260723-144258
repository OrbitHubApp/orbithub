<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>{{ app_name }} · {{ app_slogan }}</title>

  <link
    rel="icon"
    type="image/svg+xml"
    href="{{ url_for('static', path='img/orbithub-logo.svg') }}"
  >

  <link
    rel="stylesheet"
    href="{{ url_for('static', path='css/style.css') }}"
  >
</head>

<body data-refresh-seconds="{{ refresh_seconds }}">
  <main class="page">

    <header class="topbar">
      <div class="brand">
        <img
          class="brand-logo"
          src="{{ url_for('static', path='img/orbithub-logo.svg') }}"
          alt="OrbitHub Logo"
        >

        <div>
          <div class="brand-title">
            <h1>{{ app_name }}</h1>
            <span class="author">by DL7AG</span>
          </div>

          <p class="subtitle">{{ app_slogan }}</p>
        </div>
      </div>

      <div class="live-panel">
        <span class="live-dot"></span>

        <div>
          <strong>LIVE</strong>
          <span id="local-clock">--:--:--</span>
        </div>
      </div>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow">Systemstatus</div>

        <h2>TLE-Datendienst</h2>

        <p>
          Automatische Bereitstellung aktueller
          Satellitenbahndaten
        </p>
      </div>

      <span class="status {{ state_class }}">
        {{ state }}
      </span>
    </section>

    <section class="grid">

      <article class="card wide accent-blue">
        <div class="card-icon">📡</div>
        <div class="label">Aktive Quelle</div>
        <div class="value">{{ source }}</div>
      </article>

      <article class="card accent-cyan">
        <div class="card-icon">🛰️</div>
        <div class="label">Datensätze</div>
        <div class="value metric">
          {{ "{:,}".format(records) }}
        </div>
      </article>

      <article class="card accent-blue">
        <div class="card-icon">💾</div>
        <div class="label">Dateigröße</div>

        <div class="value">
          {{ "%.1f"|format(file_size_kib) }} KiB
        </div>

        <div class="subvalue">
          {{ "{:,}".format(file_size_bytes) }} Bytes
        </div>
      </article>

      <article class="card wide">
        <div class="card-icon">↩️</div>
        <div class="label">Vorherige Quelle</div>
        <div class="value">{{ previous_source }}</div>
      </article>

      <article class="card accent-yellow">
        <div class="card-icon">🔄</div>
        <div class="label">Quellenwechsel</div>
        <div class="value">{{ source_changed }}</div>
      </article>

      <article class="card">
        <div class="card-icon">⏱️</div>
        <div class="label">Aktualisierungsdauer</div>
        <div class="value">{{ duration_text }}</div>
      </article>

      <article class="card accent-green">
        <div class="card-icon">＋</div>
        <div class="label">Neue Satelliten</div>
        <div class="value metric">{{ new_satellites }}</div>
      </article>

      <article class="card accent-blue">
        <div class="card-icon">↻</div>
        <div class="label">Aktualisierte Satelliten</div>
        <div class="value metric">
          {{ updated_satellites }}
        </div>
      </article>

      <article class="card accent-red">
        <div class="card-icon">−</div>
        <div class="label">Entfernte Satelliten</div>
        <div class="value metric">
          {{ removed_satellites }}
        </div>
      </article>

      <article class="card">
        <div class="card-icon">＝</div>
        <div class="label">Unveränderte Satelliten</div>
        <div class="value metric">
          {{ unchanged_satellites }}
        </div>
      </article>

      <article class="card wide accent-cyan">
        <div class="card-icon">🕒</div>
        <div class="label">Letzte Aktualisierung</div>

        <div class="value compact">
          {{ updated_text }}
        </div>
      </article>

      <article class="card wide accent-red">
        <div class="card-icon">⚠️</div>
        <div class="label">Letzter Fehler</div>

        <div class="value compact">
          {{ error_text }}
        </div>
      </article>

    </section>

    <nav
      class="service-links"
      aria-label="OrbitHub Dienste"
    >
      <a href="/tle/all-active.tle">Standard-TLE</a>
      <a href="/satgazer/all-active.tle">SatGazer-TLE</a>
      <a href="/status">Status-JSON</a>
      <a href="/health">Health Check</a>
      <a href="/docs">API-Dokumentation</a>
    </nav>

    <footer class="footer">
      <img
        class="footer-logo"
        src="{{ url_for('static', path='img/orbithub-logo.svg') }}"
        alt=""
      >

      <div class="footer-brand">
        <strong>{{ app_name }}</strong>
        <span>{{ app_slogan }}</span>
      </div>

      <div class="footer-divider"></div>

      <div class="footer-details">
        <span>
          Version {{ version }} „{{ codename }}“
        </span>

        <span>
          Current Data Source:
          <strong>{{ source }}</strong>
        </span>

        <span>
          Designed &amp; Developed by
          <strong>DL7AG</strong>
        </span>

        <span>
          Made for the Amateur Radio Community
        </span>

        <span class="refresh-note">
          Anzeige wird in
          <strong id="refresh-countdown">
            {{ refresh_seconds }}
          </strong>
          Sekunden aktualisiert
        </span>
      </div>
    </footer>

  </main>

  <script
    src="{{ url_for('static', path='js/dashboard.js') }}"
  ></script>
</body>
</html>
