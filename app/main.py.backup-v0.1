from datetime import datetime, timezone
from pathlib import Path
import os
import time

import httpx
from fastapi import FastAPI, HTTPException
from fastapi.responses import FileResponse, HTMLResponse, PlainTextResponse
from app.services.tle_parser import TLEParser
from app.exporters.satgazer import SatGazerExporter
from app.exporters.standard import StandardExporter

APP_NAME = "OrbitHub"
VERSION = "0.1.0"
DATA_DIR = Path("/app/data")
TLE_FILE = DATA_DIR / "all-active.tle"
SOURCE_URLS = [
    {
        "name": "CelesTrak",
        "type": "tle",
        "url": "https://celestrak.org/NORAD/elements/gp.php?GROUP=ACTIVE&FORMAT=TLE",
    },
    {
        "name": "CelesTrak WWW",
        "type": "tle",
        "url": "https://www.celestrak.org/NORAD/elements/gp.php?GROUP=ACTIVE&FORMAT=TLE",
    },
    {
        "name": "SatNOGS",
        "type": "satnogs_json",
        "url": "https://db.satnogs.org/api/tle/?format=json",
    },
]

app = FastAPI(
    title=APP_NAME,
    version=VERSION,
    description="Self-hosted satellite orbit data service",
)

status = {
    "ok": False,
    "source": None,
    "previous_source": None,
    "source_changed": False,
    "updated_utc": None,
    "records": 0,
    "file_size_bytes": 0,
    "new_satellites": 0,
    "updated_satellites": 0,
    "removed_satellites": 0,
    "unchanged_satellites": 0,
    "last_update_duration_ms": 0,
    "error": "Noch keine Aktualisierung durchgeführt",
}


async def update_tle() -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)

    try:
        start_time = time.perf_counter()
        timeout = httpx.Timeout(45.0, connect=30.0)
        text = None
        active_source = None
        source_errors = []

        async with httpx.AsyncClient(
            timeout=timeout,
            follow_redirects=True,
        ) as client:
            for source in SOURCE_URLS:
                source_name = source["name"]
                source_type = source["type"]
                source_url = source["url"]

                try:
                    response = await client.get(source_url)
                    response.raise_for_status()

                    if source_type == "tle":
                        candidate_text = response.text.strip()

                    elif source_type == "satnogs_json":
                        payload = response.json()
                        tle_lines = []

                        for item in payload:
                            tle0 = item.get("tle0")
                            tle1 = item.get("tle1")
                            tle2 = item.get("tle2")

                            if tle0 and tle1 and tle2:
                                tle_lines.extend([tle0, tle1, tle2])

                        candidate_text = "\n".join(tle_lines).strip()

                    else:
                        raise ValueError(
                            f"Unbekannter Quellentyp: {source_type}"
                        )

                    if not candidate_text:
                        raise ValueError("Quelle lieferte keine TLE-Daten.")

                    text = candidate_text
                    active_source = source_name
                    break

                except Exception as source_exc:
                    source_errors.append(
                        f"{source_name}: {repr(source_exc)}"
                    )

        if text is None or active_source is None:
            raise RuntimeError(
                "Keine TLE-Quelle erreichbar: "
                + " | ".join(source_errors)
            )

        if not text or "\n1 " not in f"\n{text}":
            raise ValueError("Die empfangenen Daten sehen nicht wie TLE-Daten aus.")

        parser = TLEParser()

        old_records = []
        if TLE_FILE.exists():
            old_records = parser.parse_file(TLE_FILE)

        new_records = parser.parse_text(text)

        old_by_norad = {record.norad_id: record for record in old_records}
        new_by_norad = {record.norad_id: record for record in new_records}

        new_satellites = len(new_by_norad.keys() - old_by_norad.keys())
        removed_satellites = len(old_by_norad.keys() - new_by_norad.keys())

        updated_satellites = 0
        unchanged_satellites = 0

        for norad_id in new_by_norad.keys() & old_by_norad.keys():
            old_record = old_by_norad[norad_id]
            new_record = new_by_norad[norad_id]

            if (
                old_record.name != new_record.name
                or old_record.line1 != new_record.line1
                or old_record.line2 != new_record.line2
            ):
                updated_satellites += 1
            else:
                unchanged_satellites += 1

        records = len(new_records)

        temp_file = TLE_FILE.with_suffix(".tmp")
        temp_file.write_text(text + "\n", encoding="utf-8")
        temp_file.replace(TLE_FILE)
        previous_source = status["source"]
        update_duration_ms = round(
            (time.perf_counter() - start_time) * 1000
        )
        status.update(
            {
                "ok": True,
                "source": active_source,
                "previous_source": previous_source,
                "source_changed": (
                    previous_source is not None
                    and previous_source != active_source
                ),
                "updated_utc": datetime.now(timezone.utc).isoformat(),
                "records": records,
                "file_size_bytes": TLE_FILE.stat().st_size,
                "new_satellites": new_satellites,
                "updated_satellites": updated_satellites,
                "removed_satellites": removed_satellites,
                "unchanged_satellites": unchanged_satellites,
                "error": None,
                "last_update_duration_ms": update_duration_ms,
            }
        )
    except Exception as exc:
        status.update(
            {
                "ok": TLE_FILE.exists(),
                "error": repr(exc),
            }
        )
        print(f"OrbitHub update error: {repr(exc)}")

@app.on_event("startup")
async def startup_event() -> None:
    await update_tle()


@app.get("/", response_class=HTMLResponse)
async def index() -> str:
    state = "OK" if status["ok"] else "FEHLER"
    state_class = "ok" if status["ok"] else "error"

    source_changed_text = (
        "Ja"
        if status["source_changed"]
        else "Nein"
    )

    error_text = status["error"] or "Kein Fehler"

    if status["updated_utc"]:
        updated_dt = datetime.fromisoformat(status["updated_utc"])
        updated_local = updated_dt.astimezone()
        updated_text = updated_local.strftime("%d.%m.%Y, %H:%M:%S")
    else:
        updated_text = "Noch nie"

    file_size_kib = status["file_size_bytes"] / 1024

    duration_total_seconds = status["last_update_duration_ms"] / 1000
    duration_minutes = int(duration_total_seconds // 60)
    duration_remaining_seconds = duration_total_seconds % 60

    if duration_minutes > 0:
        duration_text = (
            f"{duration_minutes} Min. "
            f"{duration_remaining_seconds:.1f} Sek."
        )
    else:
        duration_text = f"{duration_remaining_seconds:.1f} Sek."

    return f"""
    <!doctype html>
    <html lang="de">
      <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>OrbitHub Status</title>
        <style>
          body {{
            font-family: system-ui, sans-serif;
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
            line-height: 1.5;
            background: #f4f6f8;
            color: #1f2933;
          }}

          h1 {{
            margin-bottom: 4px;
          }}
        .title-row {{
            display: flex;
            align-items: baseline;
            gap: 16px;
          }}
          
          .title-row h1 {{
            margin: 0;
          }}
          
          .author {{
            color: #66788a;
            font-size: 1.1rem;
            font-weight: 500;
          }}

          .subtitle {{
            margin-top: 0;
            color: #52606d;
          }}

          .status {{
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 700;
          }}

          .ok {{
            background: #d9f7e8;
            color: #176b45;
          }}

          .error {{
