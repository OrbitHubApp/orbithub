            margin: 0 12px 10px 0;
          }}

          code {{
            background: #eef2f5;
            padding: 2px 6px;
            border-radius: 4px;
          }}
        </style>
      </head>

      <body>
        <div class="title-row">
          <h1>OrbitHub</h1>
          <span class="author">by DL7AG</span>
        </div>
        <p class="subtitle">Self-hosted satellite orbit data service</p>

        <p>
          <span class="status {state_class}">{state}</span>
        </p>

        <div class="grid">
          <div class="card">
