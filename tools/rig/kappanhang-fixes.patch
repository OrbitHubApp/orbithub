+// decodeRptrOffs: Duplex-Ablage, 3 Bytes BCD (Einerstelle zuerst) in 100 Hz.
+func (s *civControlStruct) decodeRptrOffs(d []byte) bool {
+	if len(d) < 3 {
+		return !s.state.getRptrOffs.pending && !s.state.setRptrOffs.pending
+	}
+	s.state.rptrOffsHz = s.decodeFreqData(d[:3]) * 100
+	if s.state.getRptrOffs.pending {
+		s.removePendingCmd(&s.state.getRptrOffs)
+		return false
+	}
+	if s.state.setRptrOffs.pending {
+		s.removePendingCmd(&s.state.setRptrOffs)
+		return false
+	}
+	return true
+}
+
+// decodeTone: 1B 00 = Relais-Tonfrequenz, 3 Bytes BCD (hoechste Stelle zuerst) in 0,1 Hz.
+func (s *civControlStruct) decodeTone(d []byte) bool {
+	if len(d) < 1 || d[0] != 0x00 {
+		return true
+	}
+	if len(d) < 4 {
+		return !s.state.getTone.pending && !s.state.setTone.pending
+	}
+	v := 0
+	for _, b := range d[1:4] {
+		v = v*100 + int(b>>4)*10 + int(b&0x0f)
+	}
+	s.state.toneTenths = v
+	if s.state.getTone.pending {
+		s.removePendingCmd(&s.state.getTone)
+		return false
+	}
+	if s.state.setTone.pending {
+		s.removePendingCmd(&s.state.setTone)
+		return false
+	}
+	return true
+}
