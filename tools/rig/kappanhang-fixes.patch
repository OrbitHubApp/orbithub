+// expireLater entfernt einen Befehl nach `after` aus der Wiederholungsliste,
+// falls das Geraet nicht wie erwartet geantwortet hat (sonst endlose Wiederholung).
+func (s *civControlStruct) expireLater(cmd *civCmd, after time.Duration) {
+	go func() {
+		time.Sleep(after)
+		s.state.mutex.Lock()
+		if cmd.pending {
+			log.Debug("giving up on cmd ", cmd.name)
+			s.removePendingCmd(cmd)
+		}
+		s.state.mutex.Unlock()
+	}()
+}
+
+func toBCDLE(v uint, n int) []byte {
+	out := make([]byte, n)
+	for i := 0; i < n; i++ {
+		lo := byte(v % 10)
+		v /= 10
+		hi := byte(v % 10)
+		v /= 10
+		out[i] = hi<<4 | lo
+	}
+	return out
+}
+
+// setRptrOffs setzt die Duplex-Ablage (Hz, auf 100 Hz gerundet).
+func (s *civControlStruct) setRptrOffs(hz uint) error {
+	b := toBCDLE((hz+50)/100, 3)
+	s.initCmd(&s.state.setRptrOffs, "setRptrOffs", []byte{254, 254, civAddress, 224, 0x0d, b[0], b[1], b[2], 253})
+	s.expireLater(&s.state.setRptrOffs, time.Second)
+	return s.sendCmd(&s.state.setRptrOffs)
+}
+
+func (s *civControlStruct) getRptrOffs() error {
+	s.initCmd(&s.state.getRptrOffs, "getRptrOffs", []byte{254, 254, civAddress, 224, 0x0c, 253})
+	s.expireLater(&s.state.getRptrOffs, time.Second)
+	return s.sendCmd(&s.state.getRptrOffs)
+}
+
+// setTone setzt die Relais-Tonfrequenz (CTCSS) in 0,1 Hz, z. B. 885 = 88,5 Hz.
+func (s *civControlStruct) setTone(tenths int) error {
+	b := toBCDLE(uint(tenths), 3)
+	s.initCmd(&s.state.setTone, "setTone", []byte{254, 254, civAddress, 224, 0x1b, 0x00, b[2], b[1], b[0], 253})
+	s.expireLater(&s.state.setTone, time.Second)
+	return s.sendCmd(&s.state.setTone)
+}
+
+func (s *civControlStruct) getTone() error {
+	s.initCmd(&s.state.getTone, "getTone", []byte{254, 254, civAddress, 224, 0x1b, 0x00, 253})
+	s.expireLater(&s.state.getTone, time.Second)
+	return s.sendCmd(&s.state.getTone)
+}
+
+// setToneFunc schaltet TONE (0x42, Ton beim Senden) bzw. TSQL (0x43) ein/aus.
+func (s *civControlStruct) setToneFunc(sub byte, on bool) error {
+	var v byte
+	if on {
+		v = 1
+	}
+	cmd := &s.state.setToneFunc
+	name := "setToneFunc"
+	if sub == 0x43 {
+		cmd, name = &s.state.setTSQLFunc, "setTSQLFunc"
+	}
+	s.initCmd(cmd, name, []byte{254, 254, civAddress, 224, 0x16, sub, v, 253})
+	s.expireLater(cmd, time.Second)
+	return s.sendCmd(cmd)
+}
+
+func (s *civControlStruct) getToneFuncs() error {
+	s.initCmd(&s.state.getToneFunc, "getToneFunc", []byte{254, 254, civAddress, 224, 0x16, 0x42, 253})
+	s.expireLater(&s.state.getToneFunc, time.Second)
+	if err := s.sendCmd(&s.state.getToneFunc); err != nil {
+		return err
+	}
+	s.initCmd(&s.state.getTSQLFunc, "getTSQLFunc", []byte{254, 254, civAddress, 224, 0x16, 0x43, 253})
+	s.expireLater(&s.state.getTSQLFunc, time.Second)
+	return s.sendCmd(&s.state.getTSQLFunc)
+}
